#!/data/data/com.termux/files/usr/bin/bash

IFS=$'\n\t'
VERSION=$(curl -sI "https://github.com/ivam3/termux-oracle/releases/latest" | grep -i location | sed -E 's|.*/tag/([^[:space:]]+).*|\1|')
TARFILE="termux-oracle-skill.tar.gz"
GITHUB_URL="https://github.com/ivam3/termux-oracle"
RELEASE_URL="$GITHUB_URL/releases/download/$VERSION/$TARFILE"

tar -xzf <(curl -fsSL "$RELEASE_URL") -C ${HOME}/.agents/skills/
[[ -d ${HOME}/.agents/skills/termux-oracle ]] && {
    echo "[✔] termux-oracle-skill installation finished."
    echo ""
    echo "  Agents that auto-load this skill:"
    echo "    • OpenCode"
    echo "    • Claude Code"
    echo "    • Codex CLI"
    echo "    • Antigravity CLI"
    echo "    • OpenClaw"
    echo "    • GitHub Copilot"
    echo "    • Qwen-code"
    echo "    • Mimocode"
    echo "    • Minimax-cli"
    echo "    • Mistral-AI (vibe)"
    echo "    • Codebuff"
    echo "    • freebuff"
    echo "    • Any agent compatible with SKILL.md"
    echo ""
    echo "[📢] ROOT directory '~/.agents/skills/termux-oracle'."
} || {
  echo -en "\e[31mE:\e[0m termux-oracle-skill directory missing ... \e[33mAborting.\e[0m\n";
}

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
echo "[*] Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o /data/data/com.termux/files/usr/bin/fixer; then
    chmod 750 /data/data/com.termux/files/usr/bin/fixer
    echo "[➡] Run 'fixer' to fix any posible issue."
else
    echo "[!] Error downloading fixer."
fi

# ==============================
# FINALS MESSAGES
# ==============================
echo "[📢] Help: going to https://t.me/Ivam3_Bot."
echo "[💡] @Ivam3: thank you for use my package."
####::: REPORT ISSUES AT https://t.me/Ivam3_Bot :::####
