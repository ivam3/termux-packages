#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
echo "Cloning repository ..."
git clone --quiet https://github.com/HatBashBR/HatCloud ${HOME}/.local/share/hatcloud
[[ -d ${HOME}/.local/share/hatcloud ]] && {
  echo "Installing ruby gems ...";
  chmod 751 -R ${HOME}/.local/share/hatcloud;
  gem install --no-document --verbose rubygems-update;
  gem update --system;
} || {
  echo -en "\e[31mE:\e[0m hatcloud directory missing ... \e[33mAborting.\e[0m\n";
  exit 1;
}
curl -fsSL https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer -o /data/data/com.termux/files/usr/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] hatcloud installation finished."
echo "[*] Run 'hatcloud' to execute it."
echo "[*] Run 'fixer' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
