#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
TOOL_NAME="AXMLPrinter2"
SOURCE="https://storage.googleapis.com/google-code-archive-downloads/v2/code.google.com/android4me"
JARFILE="$TOOL_NAME.jar"
URL_DOWNLOAD="$SOURCE/$JARFILE"

echo "Installing JAR file ..."
curl -fsSL "$URL_DOWNLOAD" -o "${HOME}/.local/share/$TOOL_NAME.jar"
[[ -e ${HOME}/.local/share/$TOOL_NAME.jar ]] && { 
    chmod 751 ${HOME}/.local/share/$TOOL_NAME.jar ${PREFIX}/bin/$TOOL_NAME
    echo "[✔] $TOOL_NAME installation finished."
    echo "[*] Run 'axmlprinter2' to execute it."
} || {
  echo -en "\e[31mE:\e[0m axmlprinter2.jar directory missing ... \e[33mAborting.\e[0m\n";
}

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
echo "[*] Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o /data/data/com.termux/files/usr/bin/fixer; then
    chmod 750 /data/data/com.termux/files/usr/bin/fixer
else
    echo "[!] Error downloading fixer."
fi

echo "[➡] Run 'fixer' to fix any posible issue."
echo "[📢] Help: going to https://t.me/Ivam3_Bot."
echo "[💡] @Ivam3: thank you for use my package."
