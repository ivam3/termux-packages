#!/data/data/com.termux/files/usr/bin/bash
#Created on Jan/2022
IFS=$'\n\t'
trap ctrl_c 2

# COLORS
W="\e[0m"
R="\e[31m"
G="\e[32m"
Y="\e[33m"
B="\e[34m"

ctrl_c(){ printf "\n$Y\n   (¿) Need a help (?)$B\nTelegram : t.me/Ivam3_Bot$W\n";exit 0;}

[[ -d ${HOME}/.local/share/dex2jar ]] || {
	echo -en "$R(➤_)$W dex2jar is not installed..$Y Aborting.$W";
	exit 0;
}

tool="$1"
shift 2>/dev/null

if [[ -z "$tool" ]]; then
	printf "$Y(_>)_usage :─➤$W dex2jar <tool> <options + arguments>\n$Y ╰──➤$W Example : dex2jar d2j-dex2jar -f ~/path/to/apk_to_decompile.apk$G\n"
	echo "AVAILABLE TOOLS"
	tools=$(ls ${HOME}/.local/share/dex2jar/d2j-*.sh 2>/dev/null | while read -r f; do basename "$f" .sh; done)
	echo "$tools" | sed 's/^/  - /'
	printf "$W\n"
	exit 0
fi

# List available tools (exclude helper scripts like d2j_invoke.sh)
tools=$(ls ${HOME}/.local/share/dex2jar/d2j-*.sh 2>/dev/null | while read -r f; do basename "$f" .sh; done)
match=""
while read -r t; do
	if [[ "$t" == "$tool" ]]; then
		match="$t"
		break
	fi
done <<< "$tools"

if [[ -z "$match" ]]; then
	echo -en "$R(➤_)$W tool '$tool' not found.$Y\n$W"
	echo "AVAILABLE TOOLS"
	echo "$tools" | sed 's/^/  - /'
	exit 1
fi

bash ${HOME}/.local/share/dex2jar/${match}.sh "$@"

