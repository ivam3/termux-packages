#!/data/data/com.termux/files/usr/bin/bash
# COLORS
W="\e[0m"
R="\e[31m"
G="\e[32m"
Y="\e[33m"
B="\e[34m"
APP_PATH="${HOME}/.local/share/evilginx2"
if [[ -e ${APP_PATH}/src/build/evilginx ]]
then
  cd ${APP_PATH}/src/build >/dev/null
  ./evilginx -p ${APP_PATH}/phishlets ${@:1}
else
  echo -en $R"E:$W $(basename $0) PATH missing ...$Y Aborting.$W"
  exit 1
fi
