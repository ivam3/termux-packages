#!/data/data/com.termux/files/usr/bin/bash
if [[ $(id -u) -eq 0 ]]; then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  exit 1
fi

echo -e "\e[36m[*]\e[0m Preparing environment for walkie..."

PREFIX="/data/data/com.termux/files/usr"
INSTALL_DIR="${HOME}/.local/share/walkie"
GLOBAL_DIR="${PREFIX}/lib/node_modules/walkie-sh"

# Clean previous local install
if [[ -d "$INSTALL_DIR" ]]; then
  echo -e "\e[33m[!]\e[0m Removing previous local installation..."
  rm -rf "$INSTALL_DIR"
fi
mkdir -p "$INSTALL_DIR"

# Clean previous global install (fallback mode leftovers)
if [[ -d "$GLOBAL_DIR" ]]; then
  echo -e "\e[33m[!]\e[0m Removing previous global installation..."
  rm -rf "$GLOBAL_DIR"
fi

echo -e "\e[32m[✔]\e[0m Pre-installation preparation done."
