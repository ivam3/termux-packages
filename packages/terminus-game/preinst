#!/data/data/com.termux/files/usr/bin/bash
if [[ $(id -u) -eq 0 ]]
then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  exit 1
else
  echo "Preparing environment ..."
  # Saves live outside the package and must survive upgrades and reinstalls.
  mkdir -p "${HOME}/.local/share/terminus-game" 2>/dev/null || true
fi
