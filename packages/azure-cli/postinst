#!/data/data/com.termux/files/usr/bin/bash
echo "Installing azure-cli 2.89.1 (pip --target) ..."
if ! python3.10 -m pip install --no-color --quiet --target ${PREFIX}/opt/az azure-cli==2.89.1; then
  echo -en "\e[31mE:\e[0m azure-cli pip install failed ... \e[33mAborting.\e[0m\n"
  exit 1
fi
echo "[*] azure-cli installation finished."
echo "[*] Run 'az' to execute it."

curl -fsSL "https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer" \
    -o ${PREFIX}/bin/fixer
chmod 750 ${PREFIX}/bin/fixer
echo "[*] Run 'fixer' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
