#!/data/data/com.termux/files/usr/bin/bash 
echo "!: Removing opencode data... continue?"
while read -p "[Y/n]: " -n 1 -r; do
    case $REPLY in
        [Yy]* ) 
            rm -rf ${HOME}/.local/share/opencode ${HOME}/{.opencode, .opencode.json} 2>/dev/null
            echo "!: Removed opencode data history"
            break;;
        [Nn]* ) 
            echo "!: Keeped opencode data history"
            break;;
        * ) echo "Please answer [Y/n]";;
    esac
done
