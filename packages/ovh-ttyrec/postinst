#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
echo "Cloning repository ..."
git clone --quiet --depth=1 https://github.com/ovh/ovh-ttyrec ${HOME}/.local/share/ovh-ttyrec && cd $_
[[ -d ${HOME}/.local/share/ovh-ttyrec ]] && {
  chmod 751 -R ${HOME}/.local/share/ovh-ttyrec;
  ./configure --prefix=${PREFIX} && make && make install;
} || {
  echo -en "\e[31mE:\e[0m ovh-ttyrec directory missing ... \e[33mAborting.\e[0m\n";
}
[[ -f ${PREFIX}/bin/ttyrec ]] && {
    echo "[*] ovh-ttyrec installation finished."
    echo "[*] Run 'ttyrec|ttyplay|ttytime' to execute it."
} || {
    echo -en "\e[31mE:\e[0m ovh-ttyrec compillation failed.\e[0m\n";
}
curl -fsSL https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer \
    -o /data/data/com.termux/files/usr/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] Run 'fixer' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
####::: REPORT ISSUES AT https://t.me/Ivam3_Bot :::####
