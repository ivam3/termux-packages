#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'

echo "Downloading enum4linux-ng v1.3.10 ..."
mkdir -p ${HOME}/.local/share/enum4linux-ng
curl -fsSL "https://raw.githubusercontent.com/cddmp/enum4linux-ng/v1.3.10/enum4linux-ng.py" -o ${HOME}/.local/share/enum4linux-ng/enum4linux-ng.py || {
		echo -en "\e[31mE:\e[0m enum4linux-ng.py download failed ... \e[33mAborting.\e[0m\n"
		exit 1
	}
curl -fsSL "https://raw.githubusercontent.com/cddmp/enum4linux-ng/v1.3.10/requirements.txt" -o ${HOME}/.local/share/enum4linux-ng/requirements.txt
chmod 751 ${HOME}/.local/share/enum4linux-ng/enum4linux-ng.py

if [[ -f ${HOME}/.local/share/enum4linux-ng/enum4linux-ng.py ]]; then
  echo "Installing requirements ..."
  python -m pip --no-color --quiet --no-cache-dir install -r ${HOME}/.local/share/enum4linux-ng/requirements.txt || true
  python -c "import impacket, ldap3, yaml" || {
    echo -en "\e[31mE:\e[0m pip requirements install failed ... \e[33mAborting.\e[0m\n"
    exit 1
  }
  echo "[*] enum4linux-ng installation finished."
  echo "[*] Run 'enum4linux-ng' to execute it."
else
  echo -en "\e[31mE:\e[0m enum4linux-ng.py missing ... \e[33mAborting.\e[0m\n"
  exit 1
fi

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
echo "[*] Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o /data/data/com.termux/files/usr/bin/fixer; then
    chmod 750 /data/data/com.termux/files/usr/bin/fixer
    echo "[➡] Run 'fixer' to fix any posible issue."
else
    echo "[!] Error downloading fixer."
fi

# ==============================
# FINALS MESSAGES
# ==============================
echo "[📢] Help: going to https://t.me/Ivam3_Bot."
echo "[💡] @Ivam3: thank you for use my package."
