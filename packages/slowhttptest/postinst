#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
echo "Cloning repository ..."
git clone --quiet https://github.com/shekyan/slowhttptest ${HOME}/.local/share/slowhttptest
[[ -d ${HOME}/.local/share/slowhttptest ]] && {
  echo "Compiling ...";
  chmod 751 -R ${HOME}/.local/share/slowhttptest;
  cd ${HOME}/.local/share/slowhttptest;
  ./configure;
  make;
  if [[ -e ${HOME}/.local/share/slowhttptest/src/slowhttptest ]]
  then
    chmod +x ${HOME}/.local/share/slowhttptest/src/slowhttptest;
  else
    echo -en "\e[31mE:\e[0m Compilation failed!"
    exit 1
  fi;
} || {
  echo -en "\e[31mE:\e[0m slowhttptest directory missing ... \e[33mAborting.\e[0m\n";
  exit 1;
}
curl -fsSL https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer -o /data/data/com.termux/files/usr/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] slowhttptest installation finished."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
