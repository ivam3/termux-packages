#!/data/data/com.termux/files/usr/bin/bash
echo "!: Remove proroot container (Chromium cache, node_modules)?"
while read -p "[Y/n]: " -n 1 -r; do
    case $REPLY in
        [Yy]* )
            echo ""
            echo "!: Removing proroot container data..."
            rm -rf ${PREFIX}/var/lib/proot-distro/containers/proroot/rootfs/root/.cache 2>/dev/null || true
            rm -rf ${PREFIX}/var/lib/proot-distro/containers/proroot/rootfs/root/node_modules 2>/dev/null || true
            echo "!: playwright-proot data removed"
            break;;
        [Nn]* )
            echo ""
            echo "!: Kept proroot container data"
            break;;
        * ) echo "Please answer [Y/n]";;
    esac
done
