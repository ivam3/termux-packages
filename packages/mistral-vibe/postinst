#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
IFS=$'\n\t'

# Colors
CYAN="\033[36m"
GREEN="\033[32m"
RED="\033[31m"
YELLOW="\033[33m"
DIM="\033[2m"
RESET="\033[0m"

info() { printf "%b[📢]%b %b%s%b\n" "$CYAN" "$RESET" "$DIM" "$*" "$RESET"; }
msg()  { printf "[➡] %s\n" "$*"; }
ok()   { printf "%b[✔]%b %s\n" "$GREEN" "$RESET" "$*"; }
warn() { printf "%b[!]%b %s\n" "$YELLOW" "$RESET" "$*"; }
tip()  { printf "%b[💡]%b %s\n" "$YELLOW" "$RESET" "$*"; }
err()  { printf "%b[❌]%b %s\n" "$RED" "$RESET" "$*" >&2; }

# Ensure ~/.local/bin is in PATH (uv tool shims) — defined BEFORE uv to suppress warning
ensure_local_bin_in_path() {
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ok "~/.local/bin ya está en PATH" ;;
        *) warn "~/.local/bin no está en PATH — corrigiendo..."
           export PATH="$HOME/.local/bin:$PATH" ;;
    esac

    shell_name="$(basename "${SHELL:-}")"
    [ -z "$shell_name" ] && shell_name="$(ps -p $$ -o comm= 2>/dev/null | tr -d ' ')"
    # fish reports as 'fish', bash/zsh accordingly

    resolve_rc() { [ -L "$1" ] && readlink -f "$1" || echo "$1"; }

    line_bash_zsh='export PATH="$HOME/.local/bin:$PATH"  # mistral-vibe (uv tool)'
    line_fish='fish_add_path -g $HOME/.local/bin  # mistral-vibe (uv tool)'

    add_to_rc() {
        rc="$(resolve_rc "$1")"; line="$2"
        [ -f "$rc" ] || { mkdir -p "$(dirname "$rc")"; touch "$rc"; }
        grep -qF -- "$line" "$rc" 2>/dev/null || {
            printf '\n# Added by mistral-vibe (uv tool needs ~/.local/bin in PATH)\n%s\n' "$line" >> "$rc"
            ok "Agregado a $rc"
        }
    }

    case "$shell_name" in
        fish) add_to_rc "$HOME/.config/fish/config.fish" "$line_fish" ;;
        zsh)  add_to_rc "$HOME/.zshrc" "$line_bash_zsh"
              add_to_rc "$HOME/.local/etc/zsh/zshrc" "$line_bash_zsh" ;;
        bash) add_to_rc "$HOME/.bashrc" "$line_bash_zsh"
              add_to_rc "$HOME/.local/etc/bash/bashrc" "$line_bash_zsh" ;;
        *) # fallback: parchea los 3 para cubrir Termux multi-shell
            add_to_rc "$HOME/.bashrc" "$line_bash_zsh"
            add_to_rc "$HOME/.zshrc" "$line_bash_zsh"
            add_to_rc "$HOME/.config/fish/config.fish" "$line_fish"
            ;;
    esac
    tip "Reinicia la shell o ejecuta: export PATH=\"\$HOME/.local/bin:\$PATH\""
}

# Ensure PATH BEFORE calling uv so uv never warns
# This prevents "Installed 3 executables: ... warning: ~/.local/bin is not on your PATH"
ensure_local_bin_in_path

# Install / upgrade mistral-vibe via uv tool (idempotent, handles python 3.14)
# Use --force on fresh install and fallback to upgrade if already installed
# Filter uv's PATH warning defensively (never fatal, already handled above)
msg "Installing mistral-vibe via uv (latest)..."
set +e
_uv_output=$(uv tool install mistral-vibe --force 2>&1)
_uv_rc=$?
# Always show output but strip the spurious PATH warning
printf '%s\n' "$_uv_output" | grep -v "is not on your PATH" | grep -v "uv tool update-shell" | grep -v "fish_add_path" || true
if [ $_uv_rc -ne 0 ]; then
    msg "'uv tool install --force' failed (rc=$_uv_rc), trying 'uv tool upgrade'..."
    _upg_output=$(uv tool upgrade mistral-vibe 2>&1)
    _upg_rc=$?
    printf '%s\n' "$_upg_output" | grep -v "is not on your PATH" | grep -v "uv tool update-shell" | grep -v "fish_add_path" || true
    if [ $_upg_rc -ne 0 ]; then
        err "Failed to install/upgrade mistral-vibe via uv."
        msg "Try 'uv tool uninstall mistral-vibe && uv tool install mistral-vibe' manually."
        exit 1
    fi
fi
set -e

# Re-ensure PATH in case uv created ~/.local/bin after first check
ensure_local_bin_in_path

# Verify installation — solo warning, nunca truncar por PATH
if command -v vibe &>/dev/null; then
    ok "mistral-vibe installation finished ($(vibe --version 2>/dev/null || echo 'vibe'))"
    warn "Don't forget to set your API key (MISTRAL_API_KEY)."
    tip "Run 'vibe' to execute it."
    tip "Run 'vibe-acp' for ACP mode."
else
    warn "Installation completed but 'vibe' not found in this shell (PATH fix pending)."
    tip "Check PATH includes \$HOME/.local/bin and run 'uv tool list'."
    tip "Si acabas de corregir PATH, reinicia la shell o ejecuta: export PATH=\"\$HOME/.local/bin:\$PATH\""
    # No exit 1 — warning only, installation succeeded
fi

# ==============================
# INSTALLING SCRIPT FIXER (mantenlo siempre)
# ==============================
msg "Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o /data/data/com.termux/files/usr/bin/fixer; then
    chmod 750 /data/data/com.termux/files/usr/bin/fixer
    tip "Run 'fixer' to fix any possible issue."
else
    err "Error downloading fixer (non-fatal, continuing)."
fi

# ==============================
# FINALS MESSAGES
# ==============================
msg "Help: going to https://t.me/Ivam3_Bot."
ok "@Ivam3: thank you for use my package."
####::: REPORT ISSUES AT https://t.me/Ivam3_Bot :::####
