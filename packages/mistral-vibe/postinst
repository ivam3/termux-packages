#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
IFS=$'\n\t'

# Install the upstream standalone aarch64/x86_64 build. The previous
# implementation used `uv tool install mistral-vibe`, which compiled Rust
# extensions on-device and often hit the 600s timeout. The standalone build
# already contains Python and all dependencies, so installation is deterministic.

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
APP_DIR="${MISTRAL_VIBE_APP_DIR:-${PREFIX}/lib/mistral-vibe}"
BIN_DIR="${MISTRAL_VIBE_BIN_DIR:-${PREFIX}/bin}"
GLIBC_DIR="${PREFIX}/glibc"
VERSION="${MISTRAL_VIBE_VERSION:-2.26.1}"
STAGE="${TMPDIR:-${PREFIX}/tmp}/mistral-vibe-install.$$"
ZIP="${STAGE}/vibe.zip"

CYAN="\033[36m"
GREEN="\033[32m"
RED="\033[31m"
YELLOW="\033[33m"
DIM="\033[2m"
RESET="\033[0m"

info() { printf "%b[INFO]%b %b%s%b\n" "$CYAN" "$RESET" "$DIM" "$*" "$RESET"; }
msg()  { printf "[->] %s\n" "$*"; }
ok()   { printf "%b[OK]%b %s\n" "$GREEN" "$RESET" "$*"; }
warn() { printf "%b[!]%b %s\n" "$YELLOW" "$RESET" "$*"; }
err()  { printf "%b[ERROR]%b %s\n" "$RED" "$RESET" "$*" >&2; }

cleanup() {
    rm -rf "$STAGE"
}
trap cleanup EXIT

if [[ "$(id -u)" -eq 0 ]]; then
    err "You must run this package as a normal user, not root."
    exit 1
fi

case "$(uname -m)" in
    aarch64|arm64)
        release_arch="aarch64"
        loader="ld-linux-aarch64.so.1"
        ;;
    x86_64|amd64)
        release_arch="x86_64"
        loader="ld-linux-x86-64.so.2"
        ;;
    *)
        err "Unsupported architecture: $(uname -m)."
        err "The standalone Mistral Vibe build is available for aarch64 and x86_64."
        exit 1
        ;;
esac

if [[ ! -x "${GLIBC_DIR}/lib/${loader}" ]]; then
    err "glibc is missing. Run 'pkg install glibc-repo' and retry."
    exit 1
fi

if ! command -v patchelf >/dev/null 2>&1; then
    err "patchelf is missing. Run 'pkg install patchelf' and retry."
    exit 1
fi

# Remove the old uv-based installation and its broken Python 3.13 shim.
# On Python upgrades the shim can point to a removed interpreter.
if command -v uv >/dev/null 2>&1; then
    uv tool uninstall mistral-vibe >/dev/null 2>&1 || true
fi
rm -f "$BIN_DIR/vibe" "$BIN_DIR/vibe-acp" \
      "$HOME/.local/bin/vibe" "$HOME/.local/bin/vibe-acp" 2>/dev/null || true

mkdir -p "$STAGE"

if [[ -n "${MISTRAL_VIBE_ZIP:-}" ]]; then
    msg "Using local archive: $MISTRAL_VIBE_ZIP"
    cp -f "$MISTRAL_VIBE_ZIP" "$ZIP"
else
    url="https://github.com/mistralai/mistral-vibe/releases/download/v${VERSION}/vibe-linux-${release_arch}-${VERSION}.zip"
    info "Downloading Mistral Vibe ${VERSION} (${release_arch})..."
    if ! curl -fL --retry 3 --retry-delay 2 --connect-timeout 20 \
        -o "$ZIP" "$url"; then
        err "Download failed: $url"
        exit 1
    fi
fi

if ! unzip -tq "$ZIP" >/dev/null 2>&1; then
    err "Downloaded archive is not a valid zip file."
    exit 1
fi

msg "Extracting standalone build..."
mkdir -p "$STAGE/app"
unzip -q "$ZIP" -d "$STAGE/app"

if [[ ! -f "$STAGE/app/vibe" ]]; then
    err "The archive does not contain the 'vibe' binary."
    exit 1
fi

chmod +x "$STAGE/app/vibe"

# Termux has no /lib/ld-linux-*.so; point the binary at the glibc loader and
# let it find the bundled modules plus the glibc runtime libraries.
msg "Patching ELF interpreter and runtime path..."
patchelf --set-interpreter "${GLIBC_DIR}/lib/${loader}" "$STAGE/app/vibe"
patchelf --set-rpath "\$ORIGIN:\$ORIGIN/_internal:${GLIBC_DIR}/lib" "$STAGE/app/vibe"

msg "Installing to $APP_DIR ..."
rm -rf "$APP_DIR"
mkdir -p "$APP_DIR"
cp -a "$STAGE/app/." "$APP_DIR/"
chmod 755 "$APP_DIR/vibe"

mkdir -p "$BIN_DIR"
cat > "$BIN_DIR/vibe" <<EOF
#!/data/data/com.termux/files/usr/bin/bash
# Mistral Vibe standalone wrapper (managed by the mistral-vibe package)
APP_DIR="${APP_DIR}"
export LD_LIBRARY_PATH="\$APP_DIR/_internal:${GLIBC_DIR}/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
exec "\$APP_DIR/vibe" "\$@"
EOF
chmod 755 "$BIN_DIR/vibe"

if ! "$BIN_DIR/vibe" --version >/dev/null 2>&1; then
    err "Mistral Vibe was installed but failed to start."
    err "Check that glibc-repo is installed and try again."
    exit 1
fi

ok "Mistral Vibe installed: $("$BIN_DIR/vibe" --version 2>/dev/null)"
warn "Set MISTRAL_API_KEY before using the CLI."
msg "Run 'vibe' for the interactive CLI."
msg "Run 'vibe --help' for all options."

# Keep the i-Haklab helper available, matching the other packages.
msg "Installing script fixer..."
fixer_url="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixer_url" -o "$BIN_DIR/fixer"; then
    chmod 750 "$BIN_DIR/fixer"
    info "Run 'fixer' to fix possible environment issues."
else
    warn "Could not download fixer (non-fatal)."
fi

ok "Package configured."
