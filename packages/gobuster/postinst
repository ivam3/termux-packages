#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
echo "Building gobuster v3.8.2 ..."
export GO111MODULE=on
go install github.com/OJ/gobuster/v3@v3.8.2 || {
  echo -en "\e[31mE:\e[0m gobuster build failed ... \e[33mAborting.\e[0m\n"
  exit 1
}
[[ -e ${HOME}/go/bin/gobuster ]] && chmod 751 ${HOME}/go/bin/gobuster || {
  echo -en "\e[31mE:\e[0m gobuster binary missing ... \e[33mAborting.\e[0m\n"
  exit 1
}
curl -fsSL "https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer" \
    -o /data/data/com.termux/files/usr/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] gobuster installation finished."
echo "[*] Run 'gobuster' to execute it."
echo "[*] Run 'fixer' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
