#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'

echo "Downloading enum4linux.pl ..."
mkdir -p ${HOME}/.local/share/enum4linux
curl -fsSL "https://raw.githubusercontent.com/CiscoCXSecurity/enum4linux/master/enum4linux.pl" -o ${HOME}/.local/share/enum4linux/enum4linux.pl || {
		echo -en "\e[31mE:\e[0m enum4linux.pl download failed ... \e[33mAborting.\e[0m\n"
		exit 1
	}
chmod 751 ${HOME}/.local/share/enum4linux/enum4linux.pl

if [[ -f ${HOME}/.local/share/enum4linux/enum4linux.pl ]]; then
  echo "[*] enum4linux installation finished."
  echo "[*] Run 'enum4linux' to execute it."
else
  echo -en "\e[31mE:\e[0m enum4linux.pl missing ... \e[33mAborting.\e[0m\n"
  exit 1
fi

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
echo "[*] Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o /data/data/com.termux/files/usr/bin/fixer; then
    chmod 750 /data/data/com.termux/files/usr/bin/fixer
    echo "[➡] Run 'fixer' to fix any posible issue."
else
    echo "[!] Error downloading fixer."
fi

# ==============================
# FINALS MESSAGES
# ==============================
echo "[📢] Help: going to https://t.me/Ivam3_Bot."
echo "[💡] @Ivam3: thank you for use my package."
