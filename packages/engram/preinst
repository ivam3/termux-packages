#!/data/data/com.termux/files/usr/bin/bash
if [[ $(id -u) -eq 0 ]]
then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  exit 1
else
  echo "Preparing enviroment ..."
  [[ -d ${HOME}/.local/share/engram ]] && rm -rf ${HOME}/.local/share/engram
  [[ -e ${HOME}/go/bin/engram ]] && rm -f ${HOME}/go/bin/engram
  [[ -e ${HOME}/go/bin/engram.real ]] && rm -f ${HOME}/go/bin/engram.real
fi
