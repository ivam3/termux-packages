#!/data/data/com.termux/files/usr/bin/bash
if [[ $(id -u) -eq 0 ]]
then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  exit 1
else
  echo "Preparing enviroment ..."
  if [[ -d "${HOME}/.local/share/engram" ]]; then
    chmod -R u+w "${HOME}/.local/share/engram" 2>/dev/null || true
    rm -rf "${HOME}/.local/share/engram" 2>/dev/null || true
  fi
  rm -f "${HOME}/go/bin/engram" "${HOME}/go/bin/engram.real"
fi
exit 0
