#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'

# ==============================
# RESOLVE LATEST RELEASE
# ==============================
echo "Resolving latest engram release ..."
latest=$(curl -sI "https://github.com/Gentleman-Programming/engram/releases/latest" \
    | grep -i '^location:' | sed -E 's|.*/tag/([^[:space:]]+).*|\1|')
if [[ -z $latest ]]; then
    latest=$(curl -s 'https://proxy.golang.org/github.com/!gentleman-!programming/engram/v3/@latest' \
        | grep -oE '"Version":"[^"]+"' | cut -d'"' -f4)
fi
if [[ -z $latest ]]; then
    echo -en "\e[31mE:\e[0m Could not resolve latest engram version ... \e[33mAborting.\e[0m\n"
    exit 1
fi

# ==============================
# BUILD FROM SOURCE (pinned tag)
# ==============================
echo "Installing engram ${latest} ..."
export GO111MODULE=on
export CGO_ENABLED=0
go install "github.com/Gentleman-Programming/engram/v3/cmd/engram@${latest}" || {
    echo -en "\e[31mE:\e[0m engram build failed ... \e[33mAborting.\e[0m\n"
    exit 1
}

if [[ -x ${HOME}/go/bin/engram ]]; then
    chmod 751 ${HOME}/go/bin/engram
    echo "[✔] engram ${latest} installation finished."
    echo "[💡] Run 'engram serve' to init the server."
    echo "[💡] Run 'engram setup <AI agent name>' to setup your agent."
    echo "[➡] Run 'engram' to execute it."
else
    echo -en "\e[31mE:\e[0m engram binary missing ... \e[33mAborting.\e[0m\n"
    exit 1
fi

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
echo "[*] Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o /data/data/com.termux/files/usr/bin/fixer; then
    chmod 750 /data/data/com.termux/files/usr/bin/fixer
    echo "[➡] Run 'fixer' to fix any posible issue."
else
    echo "[!] Error downloading fixer."
fi

# ==============================
# FINALS MESSAGES
# ==============================
echo "[📢] Help: going to https://t.me/Ivam3_Bot."
echo "[💡] @Ivam3: thank you for use my package."
