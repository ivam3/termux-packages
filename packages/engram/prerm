#!/data/data/com.termux/files/usr/bin/bash
tool="engram"

rm -f "${HOME}/go/bin/${tool}" "${HOME}/go/bin/${tool}.real"
if [[ -d "${HOME}/.local/share/${tool}" ]]; then
    chmod -R u+w "${HOME}/.local/share/${tool}" 2>/dev/null || true
    rm -rf "${HOME}/.local/share/${tool}" 2>/dev/null || true
fi
if [[ -d "${HOME}/go/pkg/mod/github.com" ]]; then
    # Go module cache directories are read-only; make them writable before cleanup.
    find "${HOME}/go/pkg/mod/github.com" -maxdepth 1 -iname "*gentleman*" -exec chmod -R u+w {} + 2>/dev/null || true
    find "${HOME}/go/pkg/mod/github.com" -maxdepth 1 -iname "*gentleman*" -exec rm -rf {} + 2>/dev/null || true
fi
exit 0
