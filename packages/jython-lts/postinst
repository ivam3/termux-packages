#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
jv="2.7.4"
lv="7.2.0"
echo "Downloading jar files (It could take a while) ..."
curl -fsSL https://repo1.maven.org/maven2/org/python/jython-standalone/$jv/jython-standalone-$jv.jar \
  -o ${HOME}/.local/share/jython.jar
if [[ -e ${HOME}/.local/share/jython.jar ]]; then
  echo "Installing requirements ..."
  chmod 751 ${HOME}/.local/share/jython.jar
  [[ ! -e $PREFIX/opt/openjdk/lib/libgif.so.7 ]] && [[ -e $PREFIX/lib/libgif.so.$lv ]] && {
    ln -s $PREFIX/lib/libgif.so.$lv $PREFIX/opt/openjdk/lib/libgif.so.7;
  }
  echo "[*] jython installation finished."
  echo "[*] Run 'jython' to execute it."
else
  echo -en "\e[31mE:\e[0m jython jar file missing ... \e[33mAborting.\e[0m\n"
fi
curl -fsSL https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer -o /data/data/com.termux/files/usr/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] Run 'fixer' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
