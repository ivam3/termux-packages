#!/data/data/com.termux/files/usr/bin/bash
# COLORS
W="\e[0m"
R="\e[31m"
G="\e[32m"
Y="\e[33m"
B="\e[34m"
if [[ -e ${HOME}/.local/share/burpsuite.jar ]]
then
	[[ $(uname -m) = "aarch64" ]] || { printf >&2 "$R(➤_)$W Incompatible architecture"; exit 1; }
	[[ -S $TMPDIR/.X11-unix/X0 || -S $TMPDIR/.x11-unix/X0 || -e $TMPDIR/.X11-unix/X0 ]] || {
		printf >&2 "$R(➤_)$W Termux:Wayland server isn't running...$R aborting.$W\n"
		exit 1
	}
	export DISPLAY=:0
	umask 000
	JNA_LIB=/data/data/com.termux/files/usr/opt/burpsuite/lib
	exec $(command -v java) -Djna.boot.library.path=$JNA_LIB \
		-Djna.library.path=$JNA_LIB \
		--add-opens=java.desktop/javax.swing=ALL-UNNAMED \
		--add-opens=java.base/java.lang=ALL-UNNAMED \
		-jar ${HOME}/.local/share/burpsuite.jar
else
	echo -en "$R(➤_)$W Jar file is not installed...$R aborting.$W"
	exit 1
fi
