#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
v="11.4.1"
d="20250731"
echo "Downloading ghidra ..."
curl -fsSL https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${v}_build/ghidra_${v}_PUBLIC_${d}.zip \
  -o ${TMPDIR}/ghidra.zip
if [[ -e ${TMPDIR}/ghidra.zip ]]; then
	echo "Unpacking ghidra source code (It could take a while) ..."
	unzip -q ${TMPDIR}/ghidra.zip -d ${HOME}/.local/share
  mv ${HOME}/.local/share/ghidra_${v}_PUBLIC/ ${HOME}/.local/share/ghidra
	chmod 751 -R ${HOME}/.local/share/ghidra
  sed -i 's/^VMARGS=-Dfont.size.override=$/VMARGS=-Dfont.size.override=14/' ${HOME}/.local/share/ghidra/support/launch.properties
  if command -v termux-fix-shebang >/dev/null 2>&1; then
    find ${HOME}/.local/share/ghidra -maxdepth 2 -type f -exec termux-fix-shebang {} + >/dev/null 2>&1 || true
  fi
  echo "Building Ghidra native components ..."
  if [[ ! -x "${JAVA_HOME}/bin/java" ]]; then
    export JAVA_HOME="${PREFIX}/lib/jvm/java-21-openjdk"
  fi
  export LLVM_HOME="${PREFIX}/lib/cmake/llvm"
  export LD_LIBRARY_PATH="${LLVM_HOME}:${LD_LIBRARY_PATH}"
  if ! (cd "${HOME}/.local/share/ghidra/support/gradle" && ./gradlew --no-daemon buildNatives); then
    echo -en "\e[33mW:\e[0m Ghidra native build failed.\n"
    echo "[*] Retry manually with:"
    echo "    cd ${HOME}/.local/share/ghidra/support/gradle && ./gradlew --no-daemon buildNatives"
  fi
fi
[[ -e ${HOME}/.local/share/ghidra/ghidraRun ]] && {
  echo "[*] ghidra installation finished."
  if [[ -x ${HOME}/.local/share/ghidra/Ghidra/Features/Decompiler/build/os/linux_arm_64/decompile ]]; then
    echo "[*] Native components built for linux_arm_64."
  else
    echo -en "\e[33mW:\e[0m Native components missing; the decompiler may not work.\n"
  fi
  echo "[*] Run 'ghidra' to execute it."
} || {
  echo -en "\e[31mE:\e[0m ghidra directory missing ... \e[33mAborting.\e[0m\n"
}
curl -fsSL https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer -o ${PREFIX}/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] Run 'fixer' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
