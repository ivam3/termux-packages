#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
set -Eeuo pipefail

PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
v="12.1.4"
d="20260921"
sha256="ddac49f903da9d5bac833e5cc79395098b9c33cfd3279be5f31bd00387d2d4db"
url="https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${v}_build/ghidra_${v}_PUBLIC_${d}.zip"
zip="${TMPDIR:-/tmp}/ghidra_${v}_PUBLIC_${d}.zip"
stage_root="${HOME}/.local/share/.ghidra-stage"
stage="${stage_root}/ghidra_${v}_PUBLIC"
target="${HOME}/.local/share/ghidra"
backup="${HOME}/.local/share/ghidra.backup-$(date +%Y%m%d-%H%M%S)"

cleanup() {
  rm -rf "${stage_root}"
  rm -f "${zip}"
}
trap cleanup EXIT

echo "Downloading ghidra ..."
if ! curl -fL --retry 3 --retry-delay 2 "${url}" -o "${zip}"; then
  echo -en "\e[31mE:\e[0m Download failed; the existing installation was not changed.\n"
  exit 1
fi

echo "Verifying ghidra archive ..."
if ! (cd "$(dirname "${zip}")" && echo "${sha256}  $(basename "${zip}")" | sha256sum -c - >/dev/null 2>&1); then
  echo -en "\e[31mE:\e[0m SHA-256 mismatch; the existing installation was not changed.\n"
  exit 1
fi

echo "Unpacking ghidra source code (It could take a while) ..."
rm -rf "${stage_root}"
mkdir -p "${stage_root}"
if ! unzip -q -o "${zip}" -d "${stage_root}"; then
  echo -en "\e[31mE:\e[0m Extraction failed; the existing installation was not changed.\n"
  exit 1
fi
if [[ ! -d "${stage}" ]]; then
  echo -en "\e[31mE:\e[0m Unexpected archive layout; the existing installation was not changed.\n"
  exit 1
fi

chmod 751 -R "${stage}"
sed -i 's/^VMARGS=-Dfont.size.override=$/VMARGS=-Dfont.size.override=14/' "${stage}/support/launch.properties"
if command -v termux-fix-shebang >/dev/null 2>&1; then
  find "${stage}" -maxdepth 2 -type f -exec termux-fix-shebang {} + >/dev/null 2>&1 || true
fi

echo "Building Ghidra native components ..."
if [[ ! -x "${JAVA_HOME:-}/bin/java" ]]; then
  export JAVA_HOME="${PREFIX}/lib/jvm/java-21-openjdk"
fi
export LLVM_HOME="${PREFIX}/lib/cmake/llvm"
export LD_LIBRARY_PATH="${LLVM_HOME}:${LD_LIBRARY_PATH:-}"

native_ok=0
if (cd "${stage}/support/gradle" && ./gradlew --no-daemon buildNatives); then
  native_ok=1
else
  echo -en "\e[33mW:\e[0m Full native build failed; retrying the decompiler project.\n"
  if (cd "${stage}/support/gradle" && ./gradlew --no-daemon :Decompiler:buildNatives); then
    native_ok=1
  fi
fi

decompile="${stage}/Ghidra/Features/Decompiler/build/os/linux_arm_64/decompile"
sleigh="${stage}/Ghidra/Features/Decompiler/build/os/linux_arm_64/sleigh"
if [[ "${native_ok}" -eq 1 && -x "${decompile}" && -x "${sleigh}" ]]; then
  echo "[*] Native components built for linux_arm_64."
else
  echo -en "\e[33mW:\e[0m Ghidra native build failed; the existing installation was not changed.\n"
  echo "[*] Retry manually with:"
  echo "    cd ${stage}/support/gradle && ./gradlew --no-daemon buildNatives"
  echo "[*] The staging tree was kept at: ${stage}"
  trap - EXIT
  rm -f "${zip}"
  exit 1
fi

if [[ -d "${target}" ]]; then
  echo "[*] Keeping the previous installation at: ${backup}"
  mv "${target}" "${backup}"
fi
mv "${stage}" "${target}"
rmdir "${stage_root}" 2>/dev/null || true

if [[ -x "${target}/Ghidra/Features/Decompiler/build/os/linux_arm_64/decompile" ]]; then
  echo "[*] ghidra installation finished."
  echo "[*] Native components built for linux_arm_64."
  echo "[*] Run 'ghidra' to execute it."
else
  echo -en "\e[31mE:\e[0m ghidra directory missing ... \e[33mAborting.\e[0m\n"
  if [[ -d "${backup}" ]]; then
    rm -rf "${target}"
    mv "${backup}" "${target}"
    echo "[*] Restored the previous installation from: ${backup}"
  fi
  exit 1
fi

curl -fsSL https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer -o ${PREFIX}/bin/fixer
chmod 750 "${PREFIX}/bin/fixer"
echo "[*] Run 'fixer' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
####::: REPORT ISSUES AT https://t.me/Ivam3_Bot :::####
