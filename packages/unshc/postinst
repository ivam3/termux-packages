#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
echo "Downloading executable ..."
mkdir -p ${HOME}/.local/share/unshc
curl -fsSL https://raw.githubusercontent.com/yanncam/UnSHc/master/latest/unshc.sh \
  -o ${HOME}/.local/share/unshc/unshc.sh
[[ -e ${HOME}/.local/share/unshc/unshc.sh ]] && {
  sed 's|which|command -v|g' -i ${HOME}/.local/share/unshc/unshc.sh;
  sed 's|/tmp/XXXXXX|$PREFIX/tmp/XXXXXX|g' -i ${HOME}/.local/share/unshc/unshc.sh;
  chmod +x ${HOME}/.local/share/unshc/unshc.sh;
} || {
  echo -en "\e[31mE:\e[0m unshc missing ... \e[33mAborting.\e[0m\n";
  exit 1;
}
curl -fsSL https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer -o /data/data/com.termux/files/usr/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] unshc installation finished."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
