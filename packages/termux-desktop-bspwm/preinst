#!/data/data/com.termux/files/usr/bin/bash
if [[ $(id -u) -eq 0 ]]
then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  exit 1
else
  echo "Preparing environment ..."
  mkdir -p "${HOME}/.config/bspwm" "${HOME}/.config/sxhkd" "${HOME}/.config/polybar" \
    "${HOME}/.config/picom" "${HOME}/.config/kitty" "${HOME}/.config/rofi" 2>/dev/null
fi
