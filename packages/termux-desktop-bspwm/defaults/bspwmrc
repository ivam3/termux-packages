#!/data/data/com.termux/files/usr/bin/sh
# bspwmrc — Termux:X11 (dual with xfce4, leaves it untouched)
# 2 desktops: fits mobile screens, matches the package docs

# --- hotkeys ---
pgrep -x sxhkd > /dev/null || sxhkd &

# --- desktops ---
bspc monitor -d I II

# --- appearance ---
bspc config border_width         2
bspc config window_gap           12
bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true
bspc config bottom_padding       56
bspc config focused_border_color "#7aa2f7"
bspc config normal_border_color  "#3b4261"
bspc config presel_feedback_color "#7aa2f7"

# --- behavior (touch + physical keyboard) ---
bspc config focus_follows_pointer true
bspc config pointer_follows_focus  false
bspc config pointer_modifier       mod4
bspc config pointer_action1        move
bspc config pointer_action2        resize_side
bspc config pointer_action3        resize_corner

# --- autostart (bspwm session only) ---
# default cursor (without this the "X" stays on the background)
xsetroot -cursor_name left_ptr &
# wallpaper: fixed image (swap it by copying another to ~/.config/bspwm/wallpaper.jpg)
WALLPAPER="$HOME/.config/bspwm/wallpaper.jpg"
if [ -f "$WALLPAPER" ]; then
  feh --no-fehbg --bg-fill "$WALLPAPER" &
else
  xsetroot -solid "#1a1b26" &
fi
# compositor (if laggy on mobile: comment this line)
# with --log-file to avoid silent deaths (see ~/.config/picom/picom.log)
picom -b --log-file "$HOME/.config/picom/picom.log" 2>/dev/null &
# bar
"$HOME/.config/polybar/launch.sh" &
# bottom panel tint2 (firefox + thunar launchers)
pgrep -x tint2 > /dev/null || tint2 &
# dbus environment for gtk apps
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY 2>/dev/null &

# --- per-app rules ---
bspc rule -a Firefox desktop='^2' follow=on
bspc rule -a Gimp state=floating follow=on
bspc rule -a Rofi state=floating sticky=on manage=on
bspc rule -a Thunar state=pseudo_tiled
bspc rule -a Mousepad state=tiled
bspc rule -a Screenkey manage=off
bspc rule -a Kupfer.py focus=on
bspc rule -a mplayer2 state=floating
