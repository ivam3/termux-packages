#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
set -Eeuo pipefail

# ==============================
# CONFIGURATION
# ==============================
TOOL_NAME="phomber"
INSTALL_DIR="${HOME}/.local/share/$TOOL_NAME"

# Colors
CYAN="\033[36m"
GREEN="\033[32m"
RED="\033[31m"
YELLOW="\033[33m"
DIM="\033[2m"
RESET="\033[0m"

# Msg
info() { printf "%b[📢]%b %b%s%b\n" "$CYAN" "$RESET" "$DIM" "$*" "$RESET"; }
msg()   { printf "[➡] %s\n" "$*"; }
ok()   { printf "%b[✔]%b %s\n" "$GREEN" "$RESET" "$*"; }
warn() { printf "%b[!]%b %s\n" "$YELLOW" "$RESET" "$*"; }
tip() { printf "%b[💡]%b %s\n" "$YELLOW" "$RESET" "$*"; }
err()  { printf "%b[❌]%b %s\n" "$RED" "$RESET" "$*" >&2; }

# ==============================
# INSTALLATION
# ==============================
msg "Installing ${TOOL_NAME}..."
if git clone --quiet https://github.com/s41r4j/phomber ${HOME}/.local/share/phomber; then 
  ok "Cloned ${TOOL_NAME} repository."
else
  err "Failed to clone ${TOOL_NAME} repository."
  exit 1
fi

ok "Installing dependencies..."
cd $INSTALL_DIR
if python -m pip --no-color --quiet --no-cache-dir install -r requirements.txt; then 
  ok "Installed Python dependencies."
else
  err "Failed to install Python dependencies."
  exit 1
fi
info "Phomber needs an API key from opencagedata.com."
select way in Set_credentials Skip_this_step;do
	case $way in
		Set_credentials)
			while read -p "(_>)_username─➤ " username && [ -z $username ]
			do
				continue
			done
			while read -p "(_>)_passwd─➤ " passwd && [ -z $passwd ]
			do
				continue
			done
			printf "[Credentials]\nusername = $username\npassword = $passwd" > ${HOME}/.local/share/phomber/config/credentials.ini
			break
			;;
		*)
			info "Don't forget set your credentials at file: ~/.local/share/phomber/config/credentials.ini"
			ctrl_c
			break
			;;
	esac
done
# ==============================
# VERIFICATION
# ==============================
info "Verifying installation..."
if timeout 5 command -v $TOOL_NAME &>/dev/null; then
  ok "$TOOL_NAME installation finished."
  info "Run '$TOOL_NAME' to execute it."
else
    warn "Daemon verification timed out (expected on first run)."
fi

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
msg "Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o "${INSTALL_BIN}/fixer"; then
    chmod 750  "${INSTALL_BIN}/fixer" "${INSTALL_BIN}/walkie"
    info "Run 'fixer' to fix any posible issue."
else
    warn "Could not download fixer."
fi

# ==============================
# FINALS MESSAGES
# ==============================
tip "Help: going to https://t.me/Ivam3_Bot."
msg "@Ivam3: thank you for use my package."
