#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
set -Eeuo pipefail
: "${PREFIX:=/data/data/com.termux/files/usr}"

if [[ $(id -u) -eq 0 ]]; then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  exit 1
fi

echo "Preparing environment ..."

# Remove stale npm leftovers and any previous install
rm -f "${PREFIX}/bin/aguila"
rm -rf "${PREFIX}/lib/node_modules/aguila-lang"
rm -rf "${HOME}/.local/share/aguila-lang"
mkdir -p "${HOME}/.local/share"
