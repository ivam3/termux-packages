#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
echo "Downloading polenum ..."
mkdir -p ${HOME}/.local/share/polenum
curl -fsSL "https://raw.githubusercontent.com/Wh1t3Fox/polenum/master/polenum.py" -o ${HOME}/.local/share/polenum/polenum.py || {
  echo -en "\e[31mE:\e[0m polenum.py download failed ... \e[33mAborting.\e[0m\n"
  exit 1
}
chmod 751 ${HOME}/.local/share/polenum/polenum.py

echo "Installing requirements ..."
python -m pip --no-color --quiet --no-cache-dir install impacket || true
python -c "import impacket" || {
  echo -en "\e[31mE:\e[0m pip requirements install failed ... \e[33mAborting.\e[0m\n"
  exit 1
}

curl -fsSL "https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer" \
    -o /data/data/com.termux/files/usr/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] polenum installation finished."
echo "[*] Run 'polenum' to execute it."
echo "[*] Run 'fixer' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
