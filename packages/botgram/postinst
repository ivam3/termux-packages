#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
APP="${HOME}/.local/share/botgram"

echo "Cloning botgram ..."
rm -rf "$APP"
if ! git clone --quiet https://github.com/ivam3/botgram "$APP"; then
  echo "[!] Could not clone botgram."
  exit 1
fi
cd "$APP" || exit 1
chmod 751 -R "$APP"

echo "Installing Python requirements ..."
if [[ -f requirements.txt ]]; then
  python -m pip install --upgrade -r requirements.txt
else
  # The legacy setup.py also tries to pip-install pandas. Pandas is provided
  # by the python-pandas APT dependency; only Telethon is needed here.
  python -m pip install --upgrade 'telethon>=1.36,<2'
fi

if [[ ! -f "${PREFIX}/bin/fixer" ]]; then
  wget --tries=20 --quiet \
    https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer \
    -O "${PREFIX}/bin/fixer" && chmod 751 "${PREFIX}/bin/fixer"
fi

echo "[*] Botgram installation finished."
echo "[*] Run 'botgram' to start the interactive menu."
echo "[*] Configure your Telegram API credentials with:"
echo "    cd ${APP} && python setup.py --config"
echo "[*] Run 'fixer' to fix possible Termux issues."
echo "[!] Help: https://t.me/Ivam3_Bot"
