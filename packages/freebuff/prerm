#!/data/data/com.termux/files/usr/bin/bash 
echo "!: Removing freebuff data... continue?"
while read -p "[Y/n]: " -n 1 -r; do
    case $REPLY in
        [Yy]* ) 
            rm -rf ${HOME}/.local/share/freebuff ${HOME}/{.freebuff, .freebuff.json} 2>/dev/null
            echo "!: Removed freebuff data history"
            break;;
        [Nn]* ) 
            echo "!: Keeped freebuff data history"
            break;;
        * ) echo "Please answer [Y/n]";;
    esac
done
