#!/data/data/com.termux/files/usr/bin/bash
# freebuff Termux - Native Post-Installation Script
set -Eeuo pipefail

# Configuration
GITHUB_URL="https://codebuff.com/api"
VERSION_URL="https://api.github.com/repos/CodebuffAI/codebuff-community"
VERSION=$(curl -fsSL $VERSION_URL/releases/latest | grep '"tag_name":' | sed -E 's/.*"freebuff-v([^"]+)".*/\1/')
TOOL_NAME="freebuff"
BINARY="$TOOL_NAME"
TARFILE="$BINARY-linux-arm64.tar.gz"
DOWNLOAD_URL="$GITHUB_URL/releases/download/${VERSION}/${TARFILE}"
INSTALL_BIN_DIR="${PREFIX}/bin"
SHARE_DIR="${HOME}/.local/share/$TOOL_NAME"
STAGING_DIR="${SHARE_DIR}/$TOOL_NAME-staging"

# Colors
CYAN="\033[36m"
GREEN="\033[32m"
RED="\033[31m"
DIM="\033[2m"
RESET="\033[0m"

info() { printf "%b[..]%b %b%s%b\n" "$CYAN" "$RESET" "$DIM" "$*" "$RESET"; }
ok()   { printf "%b [✔]%b %s\n" "$GREEN" "$RESET" "$*"; }
msg()  { printf "%b[📢]%b %s\n" "$CYAN" "$RESET" "$*"; }
tip()  { printf "%b[💡]%b %s\n" "$CYAN" "$RESET" "$*"; }
err()  { printf "%b[ERR]%b %s\n" "$RED" "$RESET" "$*" >&2; }

# Cleanup
cleanup() {
    info "Cleaning up temporary files..."
    rm -rf "$STAGING_DIR"
}
trap cleanup EXIT

mkdir -p "$STAGING_DIR" "$SHARE_DIR" "$INSTALL_BIN_DIR"
mkdir -p "${HOME}/.$TOOL_NAME"  # For config and data

# 1. Download and Extract Binary
info "Downloading $TOOL_NAME ${VERSION} (glibc)..."
if curl -fsSL "$DOWNLOAD_URL" -o "$STAGING_DIR/$TOOL_NAME.tar.gz"; then
    info "Extracting binary..."
    tar -xzf "$STAGING_DIR/$TOOL_NAME.tar.gz" -C "$STAGING_DIR/"
    # Move to final location
    if [[ -f "$STAGING_DIR/$BINARY" ]]; then
        mv -f "$STAGING_DIR/$BINARY" "$SHARE_DIR/$BINARY.real"
        chmod +x "$SHARE_DIR/$BINARY.real"
        ok "Binary installed to $SHARE_DIR/$BINARY.real"
        # 1b. Termux glibc broker fix (idempotent):
        # Bun's process.execPath under `ld-linux … freebuff.real` resolves to
        # the loader, so the TUI terminal-command broker spawn fails with
        # "terminal command broker protocol response was missing".
        # Patch the single yiT() occurrence to use process.env.FB (set by the
        # native wrapper) instead of process.execPath. Same-length replace.
        info "Patching terminal-command broker invocation (Termux glibc)..."
        if python3 - "$SHARE_DIR/$BINARY.real" <<'PYEOF'; then
import sys
p = sys.argv[1]
data = open(p, 'rb').read()
needle = b'executable:process.execPath,args:'
repl = b'executable:process.env.FB  ,args:'
n, r = data.count(needle), data.count(repl)
if n == 1 and r == 0:
    open(p, 'wb').write(data.replace(needle, repl))
    print('broker-patch: applied')
elif n == 0 and r == 1:
    print('broker-patch: already applied')
else:
    print(f'broker-patch: unexpected state needle={n} repl={r}')
    sys.exit(1)
PYEOF
            ok "Broker invocation patched."
        else
            err "Broker patch failed; '!' commands will fail."
            exit 1
        fi
    else
        err "Binary not found in archive."
        exit 1
    fi
else
    err "Failed to download $TOOL_NAME."
    exit 1
fi

# 2. Compile Wrapper
HELPER_SOURCE="${PREFIX}/share/$TOOL_NAME/${TOOL_NAME}_helper.c"
if [[ ! -f "$HELPER_SOURCE" ]]; then
    if [[ -f "./lib/${TOOL_NAME}_helper.c" ]]; then
        HELPER_SOURCE="./lib/${TOOL_NAME}_helper.c"
    else
        err "Source ${TOOL_NAME}_helper.c not found."
        exit 1
    fi
fi

info "Compiling native bootstrapper..."
if clang -O2 -o "$INSTALL_BIN_DIR/$BINARY" "$HELPER_SOURCE"; then
    chmod +x "$INSTALL_BIN_DIR/$BINARY"
    ok "Bootstrapper installed: $INSTALL_BIN_DIR/$BINARY"
else
    err "Compilation failed."
    exit 1
fi

# 3. Verification
if [[ -x "$INSTALL_BIN_DIR/$BINARY" ]]; then
    if "$INSTALL_BIN_DIR/$BINARY" --version >/dev/null 2>&1; then
        ok "$TOOL_NAME installation finished."
    else
        err "Wrapper runs but binary failed to start."
        exit 1
    fi
    # 3b. Broker self-test: simulate what the patched TUI parent does —
    # spawn the native wrapper (process.env.FB) with the broker flag and a
    # one-shot protocol file in $TMPDIR. Must print BROKER_OK and write ok:true.
    info "Verifying terminal-command broker..."
    _BROKER_PROTO="${TMPDIR:-$PREFIX/tmp}/freebuff-terminal-command-broker-$$-postinst.json"
    rm -f "$_BROKER_PROTO"
    _BROKER_REQ="{\"executable\":\"/bin/sh\",\"args\":[\"-c\",\"echo BROKER_OK\"],\"cwd\":\"$HOME\",\"env\":{\"PATH\":\"$PREFIX/bin:/system/bin\",\"HOME\":\"$HOME\"}}"
    if printf '%s' "$_BROKER_REQ" | setsid env CODEBUFF_TERMINAL_COMMAND_BROKER=1 \
        "CODEBUFF_TERMINAL_COMMAND_BROKER_PROTOCOL=$_BROKER_PROTO" \
        "$INSTALL_BIN_DIR/$BINARY" --terminal-command-broker >/dev/null 2>&1; then
        : # broker self-reaps with SIGKILL; fall through to protocol check
    fi
    if [[ -f "$_BROKER_PROTO" ]] && grep -q '"ok":true' "$_BROKER_PROTO" 2>/dev/null; then
        ok "Terminal-command broker verified."
        rm -f "$_BROKER_PROTO"
    else
        err "Broker self-test failed; '!' commands will fail."
        rm -f "$_BROKER_PROTO"
        exit 1
    fi
    msg "Run '$BINARY' to execute it."
else
    err "Installation failed."
    exit 1
fi

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
info "Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o "$INSTALL_BIN_DIR/fixer"; then
    chmod 750 $INSTALL_BIN_DIR/fixer
    ok "Run 'fixer' to fix any posible issue."
else
    err "Error downloading fixer."
fi

info "Help: https://t.me/Ivam3_Bot"
tip "@Ivam3: thank you for use my package."
