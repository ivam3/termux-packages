#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'
echo "Downloading executable ..."
mkdir -p ${HOME}/.local/share/hashid
curl -fsSL https://gitlab.com/kalilinux/packages/hash-identifier/-/raw/kali/master/hash-id.py \
  -o ${HOME}/.local/share/hashid/hash-id.py
[[ -e ${HOME}/.local/share/hashid/hash-id.py ]] && {
  echo "Giving permissions ...";
  chmod 751 ${HOME}/.local/share/hashid/hash-id.py;
} || {
  echo -en "\e[31mE:\e[0m Missing hashid executable ... \e[33mAborting.\e[0m\n";
  exit 1;
}
curl -fsSL https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer -o /data/data/com.termux/files/usr/bin/fixer
chmod 750 /data/data/com.termux/files/usr/bin/fixer
echo "[*] hashid installation finished."
echo "[*] Run \'hashid\' to execute it."
echo "[*] Run \'fixer\' to fix any posible issue."
echo "[!] For help going to https://t.me/Ivam3_Bot."
echo "[*] @Ivam3: thank you for use my package."
