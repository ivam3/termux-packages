#!/data/data/com.termux/files/usr/bin/bash
if [[ $(id -u) -eq 0 ]]; then
  echo -en "\e[31mE:\e[0m You need to be a common user\n"
  exit 1
fi

INSTALL_DIR="${HOME}/.local/share/omniroute"
INSTALL_BIN="${HOME}/.local/bin"
DATA_DIR="${HOME}/.omniroute"
NPX_CACHE="${HOME}/.npm/_npx"

echo -e "\e[36m[*]\e[0m Cleaning up omniroute files..."

# Remove installation directory
if [[ -d "$INSTALL_DIR" ]]; then
  rm -rf "$INSTALL_DIR"
  echo -e "\e[32m[✔]\e[0m Removed ${INSTALL_DIR}"
fi

# Remove wrapper
if [[ -f "${INSTALL_BIN}/omniroute" ]]; then
  rm -f "${INSTALL_BIN}/omniroute"
  echo -e "\e[32m[✔]\e[0m Removed wrapper"
fi

# Remove npx cache entries for omniroute
if [[ -d "$NPX_CACHE" ]]; then
  find "$NPX_CACHE" -maxdepth 1 -type d | while read -r dir; do
    [[ -f "$dir/package.json" ]] && grep -q "omniroute" "$dir/package.json" 2>/dev/null && rm -rf "$dir" 2>/dev/null
  done 2>/dev/null || true
fi

# Ask about data directory
if [[ -d "$DATA_DIR" ]]; then
  echo -e "\e[33m[!]\e[0m Data directory ${DATA_DIR} still exists."
  echo -e "\e[33m[!]\e[0m Run 'rm -rf ${DATA_DIR}' to remove it (includes database, keys, and config)."
fi

# Clean up npmrc allow-scripts (optional - don't remove if other packages need it)
echo -e "\e[33m[!]\e[0m ~/.npmrc allow-scripts entries were NOT modified."
echo -e "\e[33m[!]\e[0m Run 'fixer' to clean npmrc if needed."

echo -e "\e[32m[✔]\e[0m Done. Package 'omniroute' removed."
