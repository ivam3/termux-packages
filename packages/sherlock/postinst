#!/data/data/com.termux/files/usr/bin/bash
IFS=$'\n\t'

echo "Installing requirements ...";
python -m pip --no-color --quiet --no-cache-dir install requests pipx;
python -m pipx ensurepath
python -m pipx install --force sherlock-project;

# ADDING TOOL TO THE PATH IF NOT EXISTS
command -v i-Haklab >/dev/null 2>&1 || {
    shell_name=$(env |grep SHELL= | awk -F '/' '{print $NF}')
    case ${shell_name} in 
        bash)
            shFile="${HOME}/.bashrc"
            if ! grep -q "${HOME}/.local/bin" "$shFile" 2>/dev/null; then
                sed -i "10a export PATH=\"${HOME}/.local/bin:$PATH\"" "$shFile"
            fi
            ;;
        fish)
            shFile="${HOME}/.config/fish/config.fish"
            if ! grep -q "${HOME}/.local/bin" "$shFile" 2>/dev/null; then
                sed -i "10a set PATH ${HOME}/.local/bin:$PATH" "$shFile"
            fi
            ;;
        zsh)
            shFile="${HOME}/.zshrc"
            if ! grep -q "${HOME}/.local/bin" "$shFile" 2>/dev/null; then
                sed -i "10a export PATH=\"${HOME}/.local/bin:$PATH\"" "$shFile"
            fi
            ;; 
        *) 
            echo -en "\e[33mW:\e[0m Defaulting to bash configuration.\nYou will need add manually ${HOME}/.local/bin to the PATH environment variable.\n"
            ;; 
    esac
}

if [[ -x "${HOME}/.local/bin/sherlock" ]]; then
    echo "[✔] sherlock installation finished."
    echo "[➡] Run 'sherlock' to execute it."
else
  echo -en "\e[31mE:\e[0m sherlock installation fail ... \e[33mAborting.\e[0m\n";
fi

# ==============================
# INSTALLING SCRIPT FIXER
# ==============================
echo "[*] Installing script fixer..."
fixerURL="https://raw.githubusercontent.com/ivam3/i-Haklab/master/.deb/home/.local/bin/fixer"
if curl -fsSL "$fixerURL" -o /data/data/com.termux/files/usr/bin/fixer; then
    chmod 750 /data/data/com.termux/files/usr/bin/fixer
    echo "[➡] Run 'fixer' to fix any posible issue."
else
    echo "[!] Error downloading fixer."
fi

# ==============================
# FINALS MESSAGES
# ==============================
echo "[📢] Help: going to https://t.me/Ivam3_Bot."
echo "[💡] @Ivam3: thank you for use my package."
